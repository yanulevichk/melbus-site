---
import Base from '../layouts/Base.astro';
import SceneSlot from '../components/SceneSlot.astro';
import { href } from '../i18n/routes';
---
<Base locale="ru" pageKey="home" title="Страница не найдена" description="Такого адреса нет." noindex>
  <section class="nf container">
    <span class="t-eyebrow">Ошибка 404</span>
    <h1 class="t-hero">Такого адреса<br />нет.</h1>
    <p class="t-lead">Но мы доставим вас куда нужно.</p>
    <a href={href('ru', 'home')} class="btn btn--primary">На главную <span class="arrow">→</span></a>
    <SceneSlot id="404" title="Потерявшаяся белая коробка ищет адрес" pin={false} ratio="21 / 9" ratioMobile="4 / 3" />
  </section>
</Base>

<style>
  .nf { display: grid; gap: 22px; justify-items: start; padding-top: calc(var(--header-h) + 64px); padding-bottom: 96px; }
  .nf :global(.scene) { width: 100%; margin-top: 24px; }
</style>
