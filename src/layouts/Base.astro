---
import '../styles/global.css';
import '../styles/lux.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { brand } from '../config/brand';
import { locales, enabledLocales, href, type Locale, type PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  pageKey: PageKey;
  title: string;
  description: string;
  nav?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  image?: string;   // картинка для соцсетей (1200×630)
  theme?: 'lux';    // люкс-тема (черновик для сравнения)
}
const { locale, pageKey, title, description, nav, noindex = false, schema = [], image = '/og-ru.jpg', theme } = Astro.props;
const ogImage = new URL(image, brand.site).href;
const ogLocale = { ru: 'ru_RU', pl: 'pl_PL', uk: 'uk_UA', en: 'en_GB' }[locale];
const canonical = new URL(href(locale, pageKey), brand.site).href;
const fullTitle = pageKey === 'home' ? `${brand.name} — ${title}` : `${title} · ${brand.name}`;

// Разметка для Google: фирма переездов, район обслуживания (без офиса) — Варшава + 150 км, вся Польша и ЕС
const org = {
  '@context': 'https://schema.org',
  '@type': 'MovingCompany',
  '@id': `${brand.site}/#company`,
  name: brand.name,
  url: brand.site,
  logo: new URL('/icon-512.png', brand.site).href,
  image: ogImage,
  telephone: brand.contact.phone,
  email: brand.contact.email,
  areaServed: [
    { '@type': 'GeoCircle', geoMidpoint: { '@type': 'GeoCoordinates', latitude: 52.2297, longitude: 21.0122 }, geoRadius: 150000 },
    { '@type': 'City', name: 'Warszawa' },
    { '@type': 'Country', name: 'Polska' },
  ],
  openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: '00:00', closes: '23:59' }],
  paymentAccepted: 'BLIK, karta, przelew',
  currenciesAccepted: 'PLN',
  knowsLanguage: ['pl', 'ru', 'uk', 'en'],
};
const site = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${brand.site}/#website`, name: brand.name, url: brand.site, inLanguage: locales[locale].htmlLang, publisher: { '@id': `${brand.site}/#company` } };
---
<!doctype html>
<html lang={locales[locale].htmlLang} class={theme}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {enabledLocales.map((l) => <link rel="alternate" hreflang={locales[l].htmlLang} href={new URL(href(l, pageKey), brand.site).href} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(href(enabledLocales.includes('pl') ? 'pl' : enabledLocales[0], pageKey), brand.site).href} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={brand.name} />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#10161D" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {pageKey === 'home' && <link rel="preload" as="image" href="/scenes/home-hero/poster-m.webp" media="(max-width: 767px)" fetchpriority="high" />}
  <script type="application/ld+json" set:html={JSON.stringify([org, site, ...schema])} />
  <script is:inline>(function(){var d=document.documentElement;d.classList.add('js');try{if(!sessionStorage.getItem('mb-tape'))d.classList.add('tape');}catch(e){}})();</script>
  <ClientRouter />
</head>
<body data-page={pageKey}>
  <div class="curtain" data-curtain aria-hidden="true" transition:persist="curtain"><img src="/brand/mark-dark.svg" alt="" width="72" height="70" /></div>
  <a href="#main" class="skip">К содержанию</a>
  <Header locale={locale} current={nav} />
  <main id="main"><slot /></main>
  <Footer locale={locale} />
  <MobileBar locale={locale} />
  <script>import '../scripts/motion.ts';</script>
</body>
</html>

<style>
  .skip { position: absolute; left: 12px; top: -60px; z-index: 100; padding: 10px 14px; background: var(--ink); color: var(--bg); border-radius: 8px; }
  .skip:focus { top: 12px; }
</style>
