---
interface Props { eyebrow?: string; title: string; lead?: string; align?: 'left' | 'split' }
const { eyebrow, title, lead, align = 'split' } = Astro.props;
---
<div class={`shead shead--${align}`}>
  <div class="shead__l">
    {eyebrow && <span class="t-eyebrow" data-reveal>{eyebrow}</span>}
    <h2 class="t-h2" data-split set:html={title} />
  </div>
  {lead && <p class="t-lead" data-reveal>{lead}</p>}
</div>

<style>
  .shead { display: grid; gap: 20px; margin-bottom: clamp(36px, 5vw, 72px); }
  .shead__l { display: grid; gap: 16px; }
  @media (min-width: 960px) { .shead--split { grid-template-columns: 1.3fr 1fr; align-items: end; column-gap: 64px; } }
</style>
