---
interface Props { items: [string, string][]; reveal?: boolean }
const { items, reveal = true } = Astro.props;
---
<div class="faq">
  {items.map(([q, a]) => (
    <details class="faq__item" data-reveal={reveal ? '' : undefined}>
      <summary><span>{q}</span><i aria-hidden="true"></i></summary>
      <div class="faq__a"><p>{a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--line); }
  .faq__item { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 22px 0; cursor: pointer; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); font-weight: 560; letter-spacing: -0.015em; }
  summary::-webkit-details-marker { display: none; }
  summary i { position: relative; flex: none; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); }
  summary i::before, summary i::after { content: ""; position: absolute; left: 11px; right: 11px; top: 17px; height: 1.5px; background: currentColor; transition: transform .4s var(--ease); }
  summary i::after { transform: rotate(90deg); }
  .faq__item[open] summary i::after { transform: rotate(0); }
  .faq__a { padding: 0 0 24px; color: var(--muted); max-width: 70ch; }
</style>
