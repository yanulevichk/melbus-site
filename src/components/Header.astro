---
import Logo from './Logo.astro';
import { href, type Locale, type PageKey, locales, enabledLocales } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { brand } from '../config/brand';

interface Props { locale: Locale; current?: string; pageKey?: PageKey }
const { locale, current = '', pageKey = 'home' } = Astro.props;
const nav = [
  ['services', ui.nav.services[locale]],
  ['pricing', ui.nav.pricing[locale]],
  ['how', ui.nav.how[locale]],
  ['guarantee', ui.nav.guarantee[locale]],
  ['about', ui.nav.about[locale]],
  ['contact', ui.nav.contact[locale]],
] as const;
---
<header class="hdr dark-hdr" data-header transition:persist={`header-${locale}`}>
  <div class="container hdr__in">
    <a href={href(locale, 'home')} class="hdr__logo" aria-label={`${brand.name} — ${ui.a11y.home[locale]}`}><Logo variant="dark" /><i class="hdr__tape" data-logo-tape aria-hidden="true"></i></a>
    <nav class="hdr__nav" aria-label={ui.a11y.mainNav[locale]}>
      {nav.map(([k, label]) => (
        <a href={href(locale, k)} class="hdr__link" aria-current={current === k ? 'page' : undefined}>{label}</a>
      ))}
    </nav>
    <div class="hdr__right">
      {enabledLocales.length > 1 && (
        <nav class="hdr__langs" aria-label={ui.a11y.langs[locale]}>{enabledLocales.map((l) => <a href={href(l, pageKey)} lang={locales[l].htmlLang} hreflang={locales[l].htmlLang} data-astro-reload aria-current={l === locale ? 'true' : undefined}>{locales[l].label}</a>)}</nav>
      )}
      <a href={href(locale, 'quote')} class="btn btn--primary btn--sm hdr__cta" data-magnetic>{ui.cta.price[locale]}</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="sr">{ui.cta.menu[locale]}</span><i></i><i></i>
      </button>
    </div>
  </div>

  <i class="hdr__progress" data-progress aria-hidden="true"></i>
  <div class="menu" id="menu" data-menu hidden>
    <div class="container menu__in">
      <nav class="menu__nav" aria-label={ui.cta.menu[locale]}>
        {nav.map(([k, label], i) => (
          <a href={href(locale, k)} class="menu__link" data-menu-item style={`--i:${i}`}>
            <span class="menu__num">{String(i + 1).padStart(2, '0')}</span>{label}
          </a>
        ))}
      </nav>
      <div class="menu__foot" data-menu-item>
        <a href={`tel:${brand.contact.phoneHref}`} class="menu__phone">{brand.contact.phone}</a>
        <a href={href(locale, 'quote')} class="btn btn--primary">{ui.cta.price[locale]}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr { position: fixed; inset: 0 0 auto; z-index: 50; padding-top: env(safe-area-inset-top, 0px); color: var(--dark-ink); --muted: var(--dark-muted); --ink: var(--dark-ink);
    transition: transform .5s var(--ease), background .4s var(--ease), box-shadow .4s var(--ease); }
  .hdr.is-scrolled { background: color-mix(in oklab, var(--dark) 84%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); box-shadow: 0 1px 0 #26303B; }
  .hdr.is-hidden { transform: translateY(-110%); }
  .hdr__in { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .hdr__nav { display: none; gap: 4px; }
  .hdr__link { padding: 10px 14px; border-radius: 999px; font-size: .95rem; font-weight: 500; color: var(--muted); transition: color .25s, background .25s; }
  .hdr__link:hover, .hdr__link[aria-current="page"] { color: var(--dark-ink); background: rgba(255,255,255,.07); }
  .hdr__right { display: flex; align-items: center; gap: 10px; }
  .hdr__langs { display: none; gap: 2px; font-size: .85rem; font-weight: 600; }
  .hdr__langs a { padding: 6px 8px; color: var(--muted); border-radius: 8px; }
  .hdr__langs a[aria-current] { color: var(--dark-ink); }
  .hdr__cta { display: none; }
  .hdr__burger { position: relative; width: 48px; height: 48px; border: 0; border-radius: 50%; background: var(--accent); cursor: pointer; z-index: 2; }
  .hdr__burger i { position: absolute; left: 15px; right: 15px; height: 2px; background: var(--accent-ink); transition: transform .45s var(--ease), top .45s var(--ease); }
  .hdr__burger i:nth-of-type(1) { top: 20px; } .hdr__burger i:nth-of-type(2) { top: 27px; }
  .hdr__burger[aria-expanded="true"] i:nth-of-type(1) { top: 23.5px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded="true"] i:nth-of-type(2) { top: 23.5px; transform: rotate(-45deg); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  .menu { position: fixed; inset: 0; z-index: 1; background: var(--dark-2); color: var(--dark-ink); padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px)); padding-bottom: env(safe-area-inset-bottom, 0px);
    clip-path: circle(0% at calc(100% - 40px) 40px); transition: clip-path .7s var(--ease); overflow-y: auto; }
  .menu.is-open { clip-path: circle(150% at calc(100% - 40px) 40px); }
  .menu__in { min-height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 40px; padding-block: 24px 32px; }
  .menu__nav { display: grid; }
  .menu__link { display: flex; align-items: baseline; gap: 14px; padding: 14px 0; border-bottom: 1px solid #26303B; font-family: var(--font-display); font-size: clamp(1.6rem, 6.4vw, 3rem); font-weight: 560; letter-spacing: -0.03em; line-height: 1.05;
    opacity: 0; transform: translateY(24px); transition: opacity .5s var(--ease), transform .6s var(--ease); transition-delay: calc(.15s + var(--i) * .05s); }
  .menu__num { font-family: var(--font); font-size: .8rem; letter-spacing: .1em; color: var(--accent); font-weight: 500; }
  .menu.is-open .menu__link, .menu.is-open .menu__foot { opacity: 1; transform: none; }
  .menu__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; opacity: 0; transform: translateY(24px); transition: opacity .5s .5s, transform .6s .5s var(--ease); }
  .menu__phone { font-size: 1.25rem; font-weight: 600; }
  .hdr:has(.menu.is-open) .hdr__logo { position: relative; z-index: 2; }

  @media (min-width: 768px) { .hdr__cta { display: inline-flex; } }
  @media (min-width: 1120px) {
    .hdr__nav, .hdr__langs { display: flex; }
    .hdr__burger { display: none; }
  }
  .hdr__logo { position: relative; }
  .hdr__tape { position: absolute; left: -6%; right: -6%; top: 50%; height: 14px; margin-top: -7px; background: color-mix(in oklab, var(--accent) 82%, transparent); border-radius: 2px; transform: rotate(-3deg) scaleX(0); opacity: 0; pointer-events: none; mix-blend-mode: screen;
    -webkit-mask: linear-gradient(90deg, transparent 0 3px, #000 3px calc(100% - 3px), transparent calc(100% - 3px)); }
  .hdr__progress { position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: 0 50%; pointer-events: none; z-index: 2; }
</style>
