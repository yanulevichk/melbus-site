---
/**
 * СЛОТ ДЛЯ КОРОТКОГО ЗАЦИКЛЕННОГО ВИДЕО (ролики V1–V8, D1–D5).
 * Положить /public/video/<id>.mp4 (+ <id>.webm) и <id>.avif (постер), указать src={id}.
 * Видео грузится только когда попадает в экран и ставится на паузу, когда уходит.
 */
import { ui } from '../i18n/ru';
interface Props { id: string; title: string; src?: string; ratio?: string; ai?: boolean }
const { id, title, src, ratio = '4 / 5', ai = true } = Astro.props;
---
<figure class="vslot" style={`--r:${ratio}`} data-video={src ? '1' : '0'}>
  {src ? (
    <video muted playsinline loop preload="none" poster={`/video/${src}.avif`} aria-label={title}>
      <source data-src={`/video/${src}.webm`} type="video/webm" />
      <source data-src={`/video/${src}.mp4`} type="video/mp4" />
    </video>
  ) : (
    <div class="vslot__ph">
      <span class="vslot__id">{id}</span>
      <span class="vslot__t">{title}</span>
    </div>
  )}
  {ai && <span class="vslot__ai">{ui.aiLabel}</span>}
</figure>

<style>
  .vslot { position: relative; margin: 0; aspect-ratio: var(--r); border-radius: calc(var(--radius) - 4px); overflow: hidden; background: var(--surface); max-width: 100%; }
  .vslot video { width: 100%; height: 100%; object-fit: cover; }
  .vslot__ph { position: absolute; inset: 0; display: grid; align-content: end; gap: 6px; padding: 18px;
    background: repeating-linear-gradient(135deg, transparent 0 14px, color-mix(in oklab, var(--ink) 4%, transparent) 14px 28px), linear-gradient(200deg, color-mix(in oklab, var(--accent) 12%, var(--surface)), var(--surface)); }
  .vslot__id { font-size: .75rem; font-weight: 600; letter-spacing: .1em; color: var(--accent); }
  .vslot__t { font-weight: 560; line-height: 1.3; max-width: 26ch; }
  .vslot__ai { position: absolute; right: 10px; top: 10px; font-size: .68rem; padding: 3px 8px; border-radius: 999px; background: color-mix(in oklab, var(--ink) 55%, transparent); color: #fff; }
</style>
