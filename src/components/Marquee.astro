---
/**
 * БЕГУЩАЯ СТРОКА (18.11.2026): «Квартиры · Дома · Офисы · Пианино · Польша и ЕС». Сама едет медленно, от прокрутки
 * ускоряется и чуть наклоняется, при прокрутке вверх — едет в обратную сторону. Движок — data-marquee в motion.ts.
 * Слова — src/content/home.ts (marquee, 4 языка).
 */
import type { Locale } from '../i18n/routes';
import { home as H } from '../content/home';
interface Props { locale: Locale; tone?: 'light' | 'dark' }
const { locale: L, tone = 'light' } = Astro.props;
const words = [...H.marquee, ...H.marquee];   // два набора — строка длиннее любого экрана
---
<section class:list={['mq', tone === 'dark' && 'mq--dark']} aria-label={H.marqueeAria[L]}>
  <div class="mq__row" data-marquee="46" aria-hidden="true">
    <div class="mq__track">
      {words.map((w, i) => <span class:list={['mq__w', i % 2 === 1 && 'mq__w--o']}>{w[L]}<i></i></span>)}
    </div>
  </div>
</section>

<style>
  .mq { overflow: hidden; padding-block: clamp(28px, 4.5vw, 64px); border-bottom: 1px solid var(--hair); background: var(--paper, #F4F6F8); color: var(--graphite, #10161D); }
  .mq--dark { background: #0B1015; color: #fff; border-color: #26303B; }
  .mq__row { display: flex; }
  .mq__track { display: flex; flex: none; align-items: center; will-change: transform; transform: skewX(var(--sk, 0deg)); }
  .mq__w { display: inline-flex; align-items: center; flex: none; font-family: var(--font-display); font-weight: 200; font-size: clamp(2.6rem, 1.4rem + 5.4vw, 7.6rem); letter-spacing: -0.055em; line-height: 1; white-space: nowrap; }
  .mq__w--o { color: transparent; -webkit-text-stroke: 1px currentColor; }
  .mq__w--o { -webkit-text-stroke-color: var(--graphite, #10161D); }
  .mq--dark .mq__w--o { -webkit-text-stroke-color: #fff; }
  /* разделитель — кусочек бирюзового скотча */
  .mq__w i { display: inline-block; flex: none; width: .5em; height: .16em; margin: 0 .42em; background: var(--tape, #14DCD5); transform: rotate(-8deg); }
</style>
