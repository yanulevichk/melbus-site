---
/**
 * Универсальный шаблон для страниц: цены, калькулятор, гарантия, как работаем, о нас, контакты.
 * Содержание каждого раздела задаётся данными в [...path].astro — каркас один.
 */
import PageHero from '../components/PageHero.astro';
import SceneSlot from '../components/SceneSlot.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import type { Locale } from '../i18n/routes';

export interface Block { type: 'list' | 'text' | 'faq' | 'cards'; eyebrow?: string; title: string; lead?: string; items?: [string, string][] }
export interface Media { video: string; poster: string; alt: string; caption?: string; square?: boolean }
interface Props { locale: Locale; eyebrow?: string; title: string; lead?: string; scene?: { id: string; title: string; length?: number }; media?: Media; blocks?: Block[]; cta?: boolean }
const { locale, eyebrow, title, lead, scene, media, blocks = [], cta = true } = Astro.props;
---
<PageHero eyebrow={eyebrow} title={title} lead={lead}>
  {media ? (
    <figure class={`pmedia${media.square ? ' pmedia--sq' : ''}`} data-tape>
      <div class="tape__media pmedia__frame" data-video="1">
        <video muted loop playsinline preload="none" poster={media.poster} width="1280" height="720" aria-label={media.alt}>
          <source data-src={media.video} type="video/mp4" />
        </video>
        <span class="pmedia__ai">Визуализация</span>
      </div>
      {media.caption && <figcaption>{media.caption}</figcaption>}
    </figure>
  ) : scene && <SceneSlot id={scene.id} title={scene.title} length={scene.length ?? 1.4} />}
</PageHero>

{blocks.map((b) => (
  <section class="section section--tight">
    <div class="container">
      <SectionHead eyebrow={b.eyebrow} title={b.title} lead={b.lead} />
      {b.type === 'faq' && b.items && <Faq items={b.items} />}
      {b.type === 'list' && b.items && (
        <ol class="blist">{b.items.map(([t, d], i) => <li data-reveal><span class="blist__n">{String(i + 1).padStart(2, '0')}</span><div><h3 class="t-h3">{t}</h3><p class="t-muted">{d}</p></div></li>)}</ol>
      )}
      {b.type === 'cards' && b.items && (
        <div class="bcards">{b.items.map(([t, d]) => <div class="bcard" data-reveal><h3 class="t-h3">{t}</h3><p class="t-muted">{d}</p></div>)}</div>
      )}
      {b.type === 'text' && b.items && <div class="btext">{b.items.map(([t, d]) => <div data-reveal><h3 class="t-h3">{t}</h3><p class="t-muted">{d}</p></div>)}</div>}
    </div>
  </section>
))}

<slot />
{cta && <CtaBand locale={locale} />}

<style>
  .pmedia { margin: 0; display: grid; gap: 14px; }
  .pmedia__frame { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #10161D; }
  @media (min-width: 768px) { .pmedia__frame { aspect-ratio: 21 / 9; } }
  .pmedia__frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .pmedia__ai { position: absolute; right: 12px; top: 12px; z-index: 2; font-size: .72rem; padding: 4px 8px; border-radius: 2px; background: rgba(16,22,29,.55); color: #fff; backdrop-filter: blur(6px); }
  .pmedia--sq { max-width: 560px; }
  .pmedia--sq .pmedia__frame { aspect-ratio: 1; }
  .pmedia figcaption { color: var(--dark-muted, #8F9AA7); font-size: .95rem; max-width: 60ch; }
  .blist { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .blist li { display: grid; grid-template-columns: 48px 1fr; gap: 16px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .blist li div { display: grid; gap: 8px; max-width: 70ch; }
  .blist__n { font-size: .8rem; font-weight: 600; color: var(--accent-text); letter-spacing: .08em; padding-top: .35em; }
  .bcards { display: grid; gap: 12px; }
  @media (min-width: 900px) { .bcards { grid-template-columns: repeat(3, 1fr); } }
  .bcard { display: grid; gap: 10px; align-content: start; padding: 26px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .btext { display: grid; gap: 28px; max-width: 760px; }
  .btext div { display: grid; gap: 8px; }
</style>
