---
import PageHero from '../components/PageHero.astro';
import Media from '../components/Media.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { services, servicesText as T, type Service } from '../data/services';
const { locale, service: s } = Astro.props as { locale: Locale; service: Service };
const others = services.filter((x) => x.id !== s.id && x.group === s.group).slice(0, 3);
---
<PageHero eyebrow={T.one[locale]} title={s.title[locale]} lead={s.lead[locale]}>
  <Fragment slot="actions">
    <a href={href(locale, 'quote')} class="btn btn--primary" data-magnetic>{ui.cta.price[locale]} <span class="arrow">→</span></a>
    <a href={href(locale, 'pricing')} class="btn btn--ghost">{ui.nav.pricing[locale]}</a>
  </Fragment>
  <Media locale={locale} video={s.media.video} poster={s.media.poster} alt={s.title[locale]} />
</PageHero>

<section class="section section--tight">
  <div class="container">
    <SectionHead eyebrow={T.incEyebrow[locale]} title={T.incTitle[locale]} />
    <ul class="inc">{s.includes.map((it, i) => <li data-reveal><span>{String(i + 1).padStart(2, '0')}</span>{it[locale]}</li>)}</ul>
  </div>
</section>

<section class="section section--tight">
  <div class="container">
    <h2 class="t-eyebrow" data-reveal>{T.more[locale]}</h2>
    <div class="more">{others.map((o) => <a href={href(locale, `service:${o.id}`)} data-reveal><strong>{o.title[locale]}</strong><span class="t-muted">{o.short[locale]}</span></a>)}</div>
  </div>
</section>
<CtaBand locale={locale} />

<style>
  .inc { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; border-top: 1px solid var(--line); }
  @media (min-width: 900px) { .inc { grid-template-columns: 1fr 1fr; column-gap: 48px; } }
  .inc li { display: flex; gap: 18px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--line); font-size: clamp(1.1rem, 1rem + .6vw, 1.5rem); font-weight: 560; letter-spacing: -0.02em; }
  .inc li span { font-size: .8rem; color: var(--accent-text); font-weight: 600; letter-spacing: .08em; }
  .more { display: grid; gap: 12px; margin-top: 18px; }
  @media (min-width: 900px) { .more { grid-template-columns: repeat(3, 1fr); } }
  .more a { display: grid; gap: 6px; padding: 22px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface); transition: transform .4s var(--ease); }
  .more a:hover { transform: translateY(-3px); }
</style>
