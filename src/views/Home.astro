---
import SceneSlot from '../components/SceneSlot.astro';
import VideoSlot from '../components/VideoSlot.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { href, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ru';
import { brand } from '../config/brand';
import { services } from '../data/services';
import { faqHome } from '../data/faq';
import { boardOptions, DEMO } from '../data/pricing-demo';
const { locale } = Astro.props as { locale: Locale };

const steps = [
  ['V2', 'Видео', 'Снимаете квартиру на телефон — 2–3 минуты, по комнатам.'],
  ['V3', 'Цена', 'В течение 2 часов днём присылаем фиксированную цену и список вещей.'],
  ['V4', 'Бронь', 'Подтверждаете предоплатой BLIK или картой. Дата закреплена за вами.'],
  ['V5', 'Упаковка', 'Бригада в форме, перчатках и бахилах упаковывает всё по комнатам.'],
  ['V6', 'Дорога', 'Бус MELBUS едет только с вашими вещами, без перегрузок.'],
  ['V7', 'Новый дом', 'Заносим, собираем мебель и расставляем всё по местам.'],
];
const details = [
  ['D1', 'Чистота с порога', 'Бахилы поверх рабочей обуви и чистые перчатки — до того, как мы зайдём в квартиру.'],
  ['D2', 'Защита дома', 'Дорожки на пол, накладки на дверные косяки и углы. Уходим — убираем за собой.'],
  ['D3', 'Хрупкое отдельно', 'Посуда в бумаге, бокалы в пузырчатой плёнке, коробки с перегородками.'],
  ['D4', 'Порядок в коробках', 'Цвет наклейки — комната, номер — коробка, QR — список вещей внутри.'],
  ['D5', 'Одежда на вешалках', 'Гардеробные коробки со штангой: вещи приезжают не мятыми.'],
];
// точки на радаре: x, y (центр 200/200), название, крупная
const places: [number, number, string, boolean?][] = [
  [200, 200, 'Варшава', true], [204, 138, 'Легионово'], [246, 168, 'Марки'], [128, 214, 'Прушков'], [210, 262, 'Пясечно'], [258, 246, 'Отвоцк'],
  [96, 104, 'Плоцк'], [332, 186, 'Седльце'], [222, 338, 'Радом'], [80, 296, 'Лодзь'],
];
const packages = [
  { name: 'Перевозка', from: '…', note: 'Вы пакуете — мы перевозим', items: ['Бус и бригада', 'Защита мебели плёнкой и одеялами', 'Разборка и сборка кровати', 'Фиксированная цена'] },
  { name: 'Стандарт', from: '…', note: 'Самый частый выбор', items: ['Всё из «Перевозки»', 'Упаковка кухни и хрупкого', 'Набор белых коробок', 'Сборка всей мебели'], featured: true },
  { name: 'Под ключ', from: '…', note: 'Вы приезжаете в готовый дом', items: ['Всё из «Стандарта»', 'Упаковка всей квартиры', 'Распаковка и расстановка', 'Вывоз упаковки'] },
];
---

<!-- 1. ПЕРВЫЙ ЭКРАН -->
<section class="hero dark">
  <div class="container">
    <div class="hero__text">
      <span class="t-eyebrow" data-reveal>Переезды · Варшава, вся Польша и ЕС</span>
      <h1 class="t-hero" data-split>Переезд<br /><span class="accent">без доплат.</span></h1>
      <div class="hero__row">
        <p class="t-lead" data-reveal>Цена фиксируется по видео вашей квартиры и не меняется в день переезда. Упакуем, перевезём и расставим всё по местам.</p>
        <div class="hero__btns" data-reveal>
          <a href={href(locale, 'quote')} class="btn btn--primary" data-magnetic>{ui.cta.price} <span class="arrow">→</span></a>
          <a href={href(locale, 'quote') + '#video'} class="btn btn--ghost">{ui.cta.video}</a>
        </div>
      </div>
      <ul class="hero__trust" data-reveal>{ui.trust.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>
  <div class="container hero__scene">
    <SceneSlot id="home-hero" three="hero" tone="dark" mobile="auto" ai={false} length={3.2} poster="/scenes/home-hero/poster" eager ratio="16 / 9" ratioMobile="4 / 5"
      title="Анимация MELBUS: квартиру оценивают по видео, кровать, диван, холодильник, стол и все вещи помещаются в одну белую коробку MELBUS, бус везёт её через город, и в новой квартире всё снова стоит на своих местах.">
      <p class="cap" data-at="0.005" data-until="0.12"><span>01 · Видеоосмотр</span>Считаем всё по видео — заранее</p>
      <p class="cap" data-at="0.16" data-until="0.42"><span>02 · Упаковка</span>Кровать, диван, холодильник — всё в одну коробку</p>
      <p class="cap" data-at="0.47" data-until="0.58"><span>03 · Без сюрпризов</span>Закрыто, заклеено, подписано</p>
      <p class="cap" data-at="0.61" data-until="0.8"><span>04 · Дорога</span>Бус едет только с вашими вещами</p>
      <p class="cap" data-at="0.88"><span>05 · Новый адрес</span>Всё на своих местах.</p>
    </SceneSlot>
  </div>
</section>

<!-- 2. БЕГУЩАЯ СТРОКА -->
<div class="marquee" data-marquee="50" aria-hidden="true">
  <div class="marquee__track">{services.slice(0, 8).map((s) => <span>{s.title}<i>✦</i></span>)}</div>
</div>

<!-- 3. ОБЕЩАНИЕ -->
<section class="section">
  <div class="container">
    <p class="promise" data-words>Цена, которую вы приняли, — это <em>цена, которую вы заплатите.</em> Никаких «а тут ещё этаж» и «шкаф оказался тяжелее». Всё посчитано <em>по видео заранее,</em> а если что-то меняется — только <em>с вашего согласия</em> и до начала работ.</p>
  </div>
</section>

<!-- 4. КАЛЬКУЛЯТОР (тизер; слот для анимации цены) -->
<section class="section section--tight">
  <div class="container">
    <div class="calc" data-reveal>
      <div class="calc__l">
        <span class="t-eyebrow">Калькулятор</span>
        <h2 class="t-h2">Сколько стоит<br />ваш переезд?</h2>
        <p class="t-muted">Ориентир за 30 секунд. Точную цену зафиксируем по видео.</p>
      </div>
      <div class="calc__r">
        <div class="chips" role="group" aria-label="Что перевозим" data-board-for="board-home">
          {boardOptions.map((o, i) => <button type="button" class="chip" data-value={o.value} data-status={o.status} aria-pressed={i === 1 ? 'true' : 'false'}>{o.label}</button>)}
        </div>
        <div class="board" id="board-home" data-board>
          <div class="board__top"><i class="board__led"></i><span data-board-status>{boardOptions[1].status}</span><span class="board__tag">ориентир</span></div>
          <div class="board__row" aria-hidden="true">
            <span class="board__from">от</span>
            {[0, 1, 2, 3].map((i) => (
              <span class={`reel${i === 0 ? ' reel--k' : ''}`} data-reel><span class="reel__strip">{Array.from({ length: 33 }, (_, k) => <i>{k % 11 === 10 ? '' : k % 11}</i>)}</span></span>
            ))}
            <span class="board__cur">zł</span>
          </div>
          <p class="sr-only" aria-live="polite">Ориентировочная цена: от <span data-board-value>{boardOptions[1].value}</span> zł</p>
          {DEMO && <p class="board__note">Демо-цифры — ставки утверждаются</p>}
        </div>
        <a href={href(locale, 'calculator')} class="btn btn--primary">Продолжить расчёт <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- 5. КАК ЭТО РАБОТАЕТ — горизонтальная лента -->
<section class="section steps-sec">
  <div class="container">
    <SectionHead eyebrow={ui.nav.how} title="Шесть шагов<br>до нового адреса" lead="От видео на телефоне до последней собранной полки. На каждом шаге вы знаете, что будет дальше." />
  </div>
  <div class="hs" data-hscroll>
    <div class="hs__track container" data-hscroll-track>
      <div class="hs__route" aria-hidden="true">
        <svg viewBox="0 0 2400 40" preserveAspectRatio="none"><path class="hs__road" d="M0 20 C 400 0, 800 40, 1200 20 S 2000 0, 2400 20" /><path data-route d="M0 20 C 400 0, 800 40, 1200 20 S 2000 0, 2400 20" /></svg>
        <span class="hs__bus" data-route-bus><svg viewBox="0 0 46 28"><rect x="1.5" y="3" width="28" height="17" rx="3" fill="#fff" stroke="#10161D" stroke-width="1.6"/><path d="M29.5 8h7.5l6.5 6.5V20h-14z" fill="#fff" stroke="#10161D" stroke-width="1.6" stroke-linejoin="round"/><rect x="1.5" y="15" width="42" height="2.6" fill="#14DCD5"/><circle cx="9.5" cy="21.5" r="3.6" fill="#10161D"/><circle cx="35" cy="21.5" r="3.6" fill="#10161D"/></svg></span>
      </div>
      <i class="hs__fill" data-fill aria-hidden="true"></i><span class="hs__vbus" data-fill-bus aria-hidden="true"></span>
      {steps.map(([id, t, d], i) => (
        <article class="step">
          <VideoSlot id={id} title={`Шаг «${t}»`} ratio="4 / 5" />
          <div class="step__t"><span class="step__n">{String(i + 1).padStart(2, '0')}</span><h3 class="t-h3">{t}</h3></div>
          <p class="t-muted">{d}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 6. ДЕТАЛИ, КОТОРЫЕ ВИДНО -->
<section class="section">
  <div class="container">
    <SectionHead eyebrow="Стандарты MELBUS" title="Детали,<br>которые видно" lead="За нами 20 бусов и 5+ лет в логистике. Аккуратность для нас — это чек-лист бригады, а не слово в рекламе." />
    <div class="swap" data-swap>
      <div class="swap__list">
        {details.map(([id, t, d], i) => (
          <div class="swap__item" data-swap-item>
            <span class="t-eyebrow">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="t-h3">{t}</h3>
            <p class="t-muted">{d}</p>
            <div class="swap__inline"><VideoSlot id={id} title={t} ratio="4 / 3" /></div>
          </div>
        ))}
      </div>
      <div class="swap__media" aria-hidden="true">
        {details.map(([id, t]) => <div class="swap__m" data-swap-media><VideoSlot id={id} title={t} ratio="4 / 5" /></div>)}
      </div>
    </div>
  </div>
</section>

<!-- 7. ФИРМЕННАЯ КОРОБКА -->
<section class="section section--tight">
  <div class="container">
    <SectionHead eyebrow="Коробки MELBUS" title="Белые коробки<br>с порядком внутри" lead="Привезём набор за несколько дней до переезда. Наклейки по комнатам и QR со списком вещей." />
    <SceneSlot id="box" three="box" tone="light" mobile="scrub" ai={false} length={1.8} poster="/scenes/box/poster" ratio="21 / 9" ratioMobile="1 / 1" data={{ room: 'КУХНЯ', num: '07' }}
      title="Белая коробка MELBUS складывается из заготовки, заклеивается бирюзовым скотчем и получает наклейку комнаты с номером и QR-кодом.">
      <p class="cap cap--ink" data-at="0.02" data-until="0.3">Плотный белый гофрокартон</p>
      <p class="cap cap--ink" data-at="0.5" data-until="0.72">Фирменный бирюзовый скотч</p>
      <p class="cap cap--ink" data-at="0.8">Цвет — комната.<br />Номер — коробка.<br />QR — список вещей.</p>
    </SceneSlot>
  </div>
</section>

<!-- 8. ПАКЕТЫ -->
<section class="section">
  <div class="container">
    <SectionHead eyebrow={ui.nav.pricing} title="Три пакета —<br>одна честная цена" lead="Цены появятся после анализа рынка. Структура пакетов — на утверждении." />
    <div class="pk" data-inview="top 75%">
      {packages.map((p, n) => (
        <article class={`pk__card${p.featured ? ' is-featured' : ''}`} style={`--n:${n}`} data-tilt>
          <div class="pk__top"><h3 class="t-h3">{p.name}</h3><span class="t-muted">{p.note}</span></div>
          <div class="pk__price"><span class="t-muted">от</span> <strong>{p.from} zł</strong></div>
          <ul>{p.items.map((it, i) => <li style={`--i:${i}`}>{it}</li>)}</ul>
          <a href={href(locale, 'quote')} class={`btn ${p.featured ? 'btn--primary' : 'btn--ghost'}`}>{ui.cta.quote}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- 9. ГАРАНТИИ (тёмный, Vanta на компьютере) -->
<section class="guar dark" data-vanta>
  <div class="container section guar__in">
    <SectionHead eyebrow="Гарантии" title="Три обещания,<br>записанные в оферте" align="left" />
    <div class="guar__grid" data-inview>
      {[['Фиксированная цена', 'Цена из принятой оферты окончательная. Риск «не уложились по времени» — наш.'], ['Пунктуальность', 'Окно прибытия 30 минут. Опоздали по своей вине — скидка за каждые 30 минут.'], ['Сохранность', 'Защищаем мебель и дом. Если что-то повредили — возмещаем по процедуре рекламации.']].map(([t, d]) => (
        <div class="guar__item"><h3 class="t-h3">{t}</h3><p class="t-muted">{d}</p></div>
      ))}
    </div>
    <a href={href(locale, 'guarantee')} class="btn btn--ghost" data-reveal>Условия гарантии <span class="arrow">→</span></a>
  </div>
</section>

<!-- 10. ФАКТЫ -->
<section class="section">
  <div class="container facts">
    <div class="fact" data-reveal><strong><span data-count-to={brand.facts.years}>{brand.facts.years}</span>+</strong><span>лет в логистике</span></div>
    <div class="fact" data-reveal><strong>≈<span data-count-to={brand.facts.deliveriesPerMonth}>{brand.facts.deliveriesPerMonth}</span></strong><span>доставок в месяц</span></div>
    <div class="fact" data-reveal><strong>7/7</strong><span>работаем без выходных</span></div>
    <div class="fact" data-reveal><strong>150 км</strong><span>вокруг Варшавы и вся Польша</span></div>
  </div>
</section>

<!-- 11. ЗОНА РАБОТЫ -->
<section class="section section--tight">
  <div class="container area">
    <div class="area__map radar" data-inview="top 75%" aria-hidden="true">
      <svg viewBox="0 0 400 400">
        <circle cx="200" cy="200" r="190" class="ring" /><circle cx="200" cy="200" r="120" class="ring" /><circle cx="200" cy="200" r="54" class="ring ring--in" />
        <text x="200" y="22" class="rlbl">150 км</text><text x="200" y="92" class="rlbl">60 км</text>
        {places.map(([x, y, n, big], i) => (
          <g class={`pt${big ? ' pt--big' : ''}`} style={`--d:${0.25 + i * 0.09}s`}>
            <circle cx={x} cy={y} r={big ? 7 : 4} class="pt__dot" /><circle cx={x} cy={y} r={big ? 7 : 4} class="pt__ping" />
            <text x={x} y={y - (big ? 14 : 10)}>{n}</text>
          </g>
        ))}
      </svg>
      <i class="radar__sweep"></i>
    </div>
    <div class="area__text">
      <SectionHead eyebrow="Где работаем" title="Варшава<br>и 150 км вокруг" align="left" lead="Мокотув, Воля, Урсынов, Прага, Белоленка и все районы. Пясечно, Прушков, Легионово, Марки и дальше. По Польше и в страны ЕС — по запросу." />
    </div>
  </div>
</section>

<!-- 12. ОТЗЫВЫ (честно) -->
<section class="section section--tight">
  <div class="container">
    <div class="reviews" data-reveal>
      <span class="t-eyebrow">Отзывы</span>
      <h2 class="t-h2">Мы новое направление —<br />первые отзывы появятся здесь.</h2>
      <p class="t-lead">Публикуем только настоящие отзывы из Google. Каждый клиент после переезда получает ссылку, чтобы оценить нас честно.</p>
    </div>
  </div>
</section>

<!-- 13. FAQ -->
<section class="section">
  <div class="container">
    <SectionHead eyebrow="Вопросы" title="Частые вопросы" align="left" />
    <Faq items={faqHome} />
  </div>
</section>

<CtaBand locale={locale} />

<style>
  .hero { padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(28px, 6vw, 88px)); padding-bottom: clamp(32px, 5vw, 72px); }
  .hero__text { display: grid; gap: clamp(20px, 2.5vw, 32px); }
  .hero__row { display: grid; gap: 24px; }
  .hero__btns { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (max-width: 479px) { .hero__btns .btn { flex: 1 1 100%; } }
  @media (min-width: 960px) { .hero__row { grid-template-columns: 1fr auto; align-items: end; } }
  .hero__trust { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .hero__trust li { font-size: .875rem; font-weight: 520; padding: 7px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .hero__trust li::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-right: 8px; vertical-align: middle; }
  .hero__scene { margin-top: clamp(28px, 4vw, 56px); }
  .cap { position: absolute; left: clamp(12px, 2.4vw, 32px); bottom: clamp(12px, 2.4vw, 32px); max-width: min(19ch, calc(100% - 24px)); padding: 14px 18px 16px; border-radius: 16px;
    background: color-mix(in oklab, var(--dark) 72%, transparent); backdrop-filter: blur(14px) saturate(1.3); -webkit-backdrop-filter: blur(14px) saturate(1.3); border: 1px solid rgba(255,255,255,.07);
    font-family: var(--font-display); font-size: clamp(1.05rem, .78rem + 1.25vw, 1.9rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; visibility: hidden; color: var(--dark-ink); }
  .cap span { display: block; margin-bottom: 8px; font-family: var(--font); font-size: .72rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); }
  .cap--ink { color: var(--ink); max-width: 20ch; top: clamp(12px, 2.4vw, 32px); bottom: auto; background: color-mix(in oklab, #fff 70%, transparent); border-color: var(--line); }
  .promise :global(em) { font-style: normal; color: var(--accent-text); }

  .marquee { overflow: hidden; border-bottom: 1px solid var(--line); padding-block: 22px; }
  .marquee__track { display: flex; width: max-content; will-change: transform; }
  .marquee span { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-family: var(--font-display); font-size: clamp(1.4rem, .9rem + 2.2vw, 2.9rem); font-weight: 560; letter-spacing: -0.03em; white-space: nowrap; }
  .marquee i { font-style: normal; font-size: .5em; color: var(--accent-text); }

  .promise { font-family: var(--font-display); font-size: clamp(1.5rem, .95rem + 2.6vw, 3.4rem); font-weight: 560; letter-spacing: -0.03em; line-height: 1.12; max-width: 26ch; }

  .calc { display: grid; gap: 32px; padding: clamp(24px, 4vw, 56px); border-radius: calc(var(--radius) + 8px); background: var(--surface); border: 1px solid var(--line); }
  .calc__l { display: grid; gap: 14px; align-content: start; }
  .calc__r { display: grid; gap: 24px; align-content: start; }
  @media (min-width: 960px) { .calc { grid-template-columns: 1fr 1fr; } }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { padding: 12px 16px; border-radius: 999px; border: 1px solid var(--line); background: transparent; cursor: pointer; font-weight: 520; }
  .chip[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .chip { transition: background .3s var(--ease), color .3s var(--ease), border-color .3s var(--ease); }
  .chip:hover { border-color: var(--ink); }

  /* табло цены: графитовая панель, барабаны с цифрами */
  .board { --cell: clamp(52px, 11vw, 76px); position: relative; display: grid; gap: 16px; padding: 18px 18px 16px; border-radius: 18px; background: linear-gradient(180deg, #18212B 0%, #10161D 100%); color: var(--dark-ink); box-shadow: 0 1px 0 rgba(255,255,255,.06) inset, 0 24px 60px -24px rgba(16,22,29,.55); overflow: hidden; }
  .board::before { content: ""; position: absolute; inset: 0; background: radial-gradient(60% 80% at 80% 0%, rgba(20,220,213,.14), transparent 70%); pointer-events: none; }
  .board__top { position: relative; display: flex; align-items: center; gap: 10px; font-size: .78rem; font-weight: 560; letter-spacing: .1em; text-transform: uppercase; color: var(--dark-muted); }
  .board__led { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px var(--accent); animation: led 2.4s ease-in-out infinite; }
  @keyframes led { 50% { opacity: .35; } }
