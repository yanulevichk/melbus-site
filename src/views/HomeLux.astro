---
/**
 * ГЛАВНАЯ (люкс). Все тексты — в src/content/home.ts, каждая фраза сразу на 4 языках.
 * Движение: фильм первого экрана, «лента скотча» на кадрах, горизонтальные шаги.
 */
import Faq from '../components/Faq.astro';
import { href, type Locale } from '../i18n/routes';
import { ui } from '../i18n/ui';
import { brand } from '../config/brand';
import { faqFor } from '../data/faq';
import { boardOptions, DEMO, PACKAGES, GRID, moneyLocale } from '../data/pricing';
import { pkgText } from '../content/prices';
import NoHours from '../components/NoHours.astro';
import { home as H } from '../content/home';
import { areaText } from '../content/areas';
const { locale } = Astro.props as { locale: Locale };
const L = locale;
const quote = href(locale, 'quote');
const ai = ui.aiLabel[L];
const fmt = new Intl.NumberFormat(moneyLocale(L));
const EX = 1; // пример пакетов на главной — 2 комнаты
// мини-QR для наклеек (декоративный узор)
const qr = (seed: number) => {
  let r = seed; const rnd = () => ((r = (r * 9301 + 49297) % 233280) / 233280);
  const cells: [number, number][] = [];
  for (let x = 0; x < 15; x++) for (let y = 0; y < 15; y++) {
    const f = (x < 5 && y < 5) || (x > 9 && y < 5) || (x < 5 && y > 9);
    if (!f && rnd() > 0.5) cells.push([x, y]);
  }
  return cells;
};
---

<!-- 1. ПЕРВЫЙ ЭКРАН: фильм «вся квартира в одной коробке».
     Компьютер — прокрутка ведёт фильм (кадры на canvas), телефон — видео по кругу без звука. -->
<section class="lx-film dark" data-film data-intro-hero data-dur="22.5" data-length="7" data-count="270" data-base="/scenes/film/d">
  <div class="lx-film__stage" data-film-stage>
    <picture class="lx-film__poster">
      <source media="(max-width: 1023px)" srcset="/scenes/film/poster-m.webp" width="540" height="960" />
      <img src="/scenes/film/poster-d.webp" alt={H.posterAlt[L]} width="1600" height="900" fetchpriority="high" decoding="async" />
    </picture>
    <canvas class="lx-film__canvas" data-film-canvas aria-hidden="true"></canvas>
    <video class="lx-film__video" data-film-video data-src="/video/film-m.mp4" muted playsinline loop preload="none" poster="/scenes/film/poster-m.webp" aria-hidden="true"></video>
    <div class="lx-film__shade" aria-hidden="true"></div>

    <div class="container lx-film__intro" data-film-intro>
      <p class="lx-film__kicker" data-intro-fade>{H.kicker[L]}</p>
      <h1 class="lx-film__title" data-intro-title>{H.title[0][L]}<br />{H.title[1][L]}</h1>
      <i class="lx-film__line" data-intro-line aria-hidden="true"></i>
      <p class="lx-film__lead" data-intro-fade>{H.lead[L]}</p>
      <div class="lx-film__cta" data-intro-fade>
        <a href={quote} class="btn btn--primary">{ui.cta.price[L]}</a>
        <a href={quote + '#video'} class="lux-link">{ui.cta.video[L]}</a>
      </div>
      <p class="lx-film__hint" data-intro-fade aria-hidden="true"><i></i>{H.hint[L]}</p>
    </div>

    <div class="container lx-film__caps" aria-hidden="true">
      {H.caps.map(([from, to, t, d]) => (
        <p class="lx-film__cap" data-film-cap data-from={from} data-to={to}><strong>{t[L]}</strong><span>{d[L]}</span></p>
      ))}
    </div>

    <div class="container lx-film__end" data-film-cap data-from="21.6" data-to="99">
      <p class="lx-film__endt">{H.endTitle[L]}</p>
      <div class="lx-film__cta">
        <a href={quote} class="btn btn--primary">{ui.cta.price[L]}</a>
        <a href={quote + '#video'} class="lux-link">{ui.cta.video[L]}</a>
      </div>
    </div>

    <div class="lx-film__foot">
      <button type="button" class="lx-film__watch" data-film-open><i aria-hidden="true"></i>{H.watch[L]}</button>
      <span class="lx-film__ai">{ai}</span>
    </div>
    <div class="lx-film__bar" aria-hidden="true"><i data-film-progress></i></div>
  </div>
</section>

<!-- 1б. КОРОТКО О ГЛАВНОМ -->
<section class="lx-band dark">
  <div class="container">
    <ul class="lx-band__facts">
      {H.band.map(([t, d]) => <li><strong>{t[L]}</strong><span>{d[L]}</span></li>)}
    </ul>
  </div>
</section>

<!-- 2. ОБЕЩАНИЕ -->
<section class="lx-sec lx-statement">
  <div class="container lx-statement__grid">
    <div class="lx-statement__body">
      <p class="lx-statement__text">{H.statement[L]}</p>
      <a class="lux-link" href={href(locale, 'guarantee')}>{H.statementLink[L]}</a>
    </div>
    <figure class="lx-statement__media" data-tape>
      <div class="tape__media lx-vid" data-video="1">
        <video muted loop playsinline preload="none" poster="/img/site/phone.webp" width="900" height="900" aria-label={H.phoneAlt[L]}>
          <source data-src="/video/phone.mp4" type="video/mp4" />
        </video>
        <span class="lx-ai">{ai}</span>
      </div>
      <figcaption>{H.phoneCaption[L]}</figcaption>
    </figure>
  </div>
</section>

<!-- 3. ЦЕНА -->
<section class="lx-sec lx-price">
  <div class="container lx-price__grid">
    <div class="lx-price__head">
      <h2 class="lx-h2">{H.price.h2[L]}</h2>
      <p class="lx-lead">{H.price.lead[L]}</p>
    </div>
    <div class="lx-price__calc">
      <div class="lx-seg" role="group" aria-label={H.price.seg[L]} data-board-for="board-lux">
        {boardOptions.map((o, i) => <button type="button" class="lx-seg__b" data-value={o.value} data-status={o.status[L]} aria-pressed={i === 1 ? 'true' : 'false'}>{o.label[L]}</button>)}
      </div>
      <div class="lx-board" id="board-lux" data-board>
        <p class="lx-board__status" data-board-status>{boardOptions[1].status[L]}</p>
        <div class="lx-board__row" aria-hidden="true">
          <span class="lx-board__from">{H.price.from[L]}</span>
          {[0, 1, 2, 3].map((i) => (
            <span class={`lx-reel${i === 0 ? ' lx-reel--k' : ''}`} data-reel><span class="lx-reel__strip">{Array.from({ length: 33 }, (_, k) => <i>{k % 11 === 10 ? '' : k % 11}</i>)}</span></span>
          ))}
          <span class="lx-board__cur">zł</span>
        </div>
        <p class="sr-only" aria-live="polite">{H.price.sr[L]} <span data-board-value>{boardOptions[1].value}</span> zł</p>
      </div>
      {DEMO && <p class="lx-note">{H.price.demo[L]}</p>}
      <a href={href(locale, 'calculator')} class="btn btn--primary">{H.price.next[L]}</a>
    </div>
  </div>
</section>

<!-- 3б. МЫ НЕ ПРОДАЁМ ЧАСЫ -->
<NoHours locale={locale} />

<!-- 4. ШАГИ (это последовательность — номера по делу) -->
<section class="lx-sec lx-steps">
  <div class="container lx-head">
    <h2 class="lx-h2">{H.steps.h2[L]}</h2>
    <p class="lx-lead">{H.steps.lead[L]}</p>
  </div>
  <div class="lx-hs" data-hscroll>
    <div class="lx-hs__track container" data-hscroll-track>
      <div class="lx-route" aria-hidden="true"><svg viewBox="0 0 2400 40" preserveAspectRatio="none"><path class="lx-route__base" d="M0 20 L2400 20" /><path data-route d="M0 20 L2400 20" /></svg></div>
      <i class="lx-hs__fill" data-fill aria-hidden="true"></i>
      {H.steps.items.map(([img, t, d], i) => (
        <article class="lx-step">
          <div class="lx-step__media" data-slot={`V${i + 2}`}>
            <img src={`/img/film/${img}.webp`} alt="" width="720" height="900" loading="lazy" decoding="async" />
            <span class="lx-step__n">{i + 1}</span>
          </div>
          <h3 class="lx-step__t">{t[L]}</h3>
          <p class="lx-step__d">{d[L]}</p>
        </article>
      ))}
    </div>
  </div>
  <p class="container lx-note lx-steps__note">{H.steps.note[L]}</p>
</section>

<!-- 5. СТАНДАРТЫ -->
<section class="lx-sec lx-std">
  <div class="container lx-std__grid">
    <div class="lx-std__media" data-tape>
      <div class="tape__media lx-std__img lx-vid" data-slot="D1" data-video="1">
        <video muted loop playsinline preload="none" poster="/img/site/gloves.webp" width="720" height="900" aria-label={H.std.alt[L]}>
          <source data-src="/video/gloves.mp4" type="video/mp4" />
        </video>
        <span class="lx-ai">{ai}</span>
      </div>
    </div>
    <div class="lx-std__text">
      <h2 class="lx-h2">{H.std.h2[L]}</h2>
      <p class="lx-lead">{H.std.lead[L]}</p>
      <dl class="lx-list">
        {H.std.items.map(([t, d]) => <div><dt>{t[L]}</dt><dd>{d[L]}</dd></div>)}
      </dl>
    </div>
  </div>
</section>

<!-- 6. КОРОБКИ -->
<section class="lx-sec lx-boxes">
  <div class="container">
    <div class="lx-head">
      <h2 class="lx-h2">{H.boxes.h2[L]}</h2>
      <p class="lx-lead">{H.boxes.lead[L]}</p>
    </div>
    <figure class="lx-boxes__img" data-tape>
      <div class="tape__media">
        <picture>
          <source media="(max-width: 767px)" srcset="/scenes/box/poster-m.webp" />
          <img src="/scenes/box/poster-d.webp" alt={H.boxes.alt[L]} width="1600" height="688" loading="lazy" decoding="async" />
        </picture>
      </div>
    </figure>
    <ul class="lx-rooms" aria-label={H.boxes.roomsAria[L]}>
      {H.boxes.rooms.map(([room, color, n], i) => (
        <li class="lx-sticker">
          <i class="lx-sticker__bar" style={`--c:${color}`}></i>
          <span class="lx-sticker__room">{room[L]}</span>
          <span class="lx-sticker__n">{n}</span>
          <svg class="lx-sticker__qr" viewBox="0 0 15 15" aria-hidden="true">
            <path d="M0 0h5v5H0zM10 0h5v5h-5zM0 10h5v5H0z" fill="none" stroke="currentColor" stroke-width="1" transform="translate(.5 .5) scale(.933)" />
            {qr(11 + i * 17).map(([x, y]) => <rect x={x} y={y} width="1" height="1" />)}
          </svg>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 7. ПАКЕТЫ: «Под ключ» лишь немного дороже «Стандарта» (цены — src/data/pricing.ts) -->
<section class="lx-sec lx-pk">
  <div class="container">
    <div class="lx-head">
      <h2 class="lx-h2">{pkgText.h2[L]}</h2>
      <p class="lx-lead">{pkgText.lead[L]}</p>
    </div>
    <div class="lx-pk__cols">
      {PACKAGES.map((p, i) => (
        <article class={`lx-pk__col${i === 2 ? ' is-f' : ''}`}>
          {i === 2 && <span class="lx-pk__badge">{pkgText.best[L]}</span>}
          <p class="lx-pk__note">{p.note[L]}</p>
          <h3 class="lx-pk__name">{p.name[L]}</h3>
          <p class="lx-pk__price">{fmt.format(GRID[EX][i])} zł</p>
          {i > 0 && <p class="lx-pk__diff">{pkgText.more[L].replace('{d}', fmt.format(GRID[EX][i] - GRID[EX][i - 1])).replace('{n}', PACKAGES[i - 1].name[L])}</p>}
          <ul>{p.items.map((it) => <li>{it[L]}</li>)}</ul>
          <a class="lux-link" href={`${quote}?size=${EX}&pkg=${p.quote}`}>{ui.cta.quote[L]}</a>
        </article>
      ))}
    </div>
    <p class="lx-pk__calc"><a class="lux-link" href={`${href(locale, 'calculator')}?size=${EX}&pkg=2`}>{pkgText.calc[L]}</a>{DEMO && <span class="lx-note"> · {H.price.demo[L]}</span>}</p>
  </div>
</section>

<!-- 8. ГАРАНТИЯ -->
<section class="lx-sec lx-guar dark grain">
  <div class="container">
    <h2 class="lx-xl" set:html={H.guarantee.h2[L]} />
    <div class="lx-guar__cols">
      {H.guarantee.cols.map(([t, d]) => (
        <div><h3>{t[L]}</h3><p>{d[L]}</p></div>
      ))}
    </div>
    <a class="lux-link" href={href(locale, 'guarantee')}>{H.guarantee.link[L]}</a>
  </div>
</section>

<!-- 9. ЦИФРЫ -->
<section class="lx-facts">
  <div class="container lx-facts__row">
    {H.facts.map(([n, l], i) => (
      <div class="lx-fact"><strong>{i === 0 ? `${brand.facts.years}+` : n[L]}</strong><span>{l[L]}</span></div>
    ))}
  </div>
</section>

<!-- 10. ГДЕ РАБОТАЕМ -->
<section class="lx-sec lx-area">
  <div class="container lx-area__grid">
    <div>
      <h2 class="lx-h2">{H.area.h2[L]}</h2>
      <p class="lx-lead">{H.area.lead[L]}</p>
      <a class="lux-link" href={href(locale, 'areas')}>{areaText.all[L]}</a>
    </div>
    <svg class="lx-map" viewBox="0 0 400 400" role="img" aria-label={H.area.mapAria[L]}>
      <path data-draw class="lx-map__outer" d="M200 20 a180 180 0 1 1 -0.01 0" />
      <circle cx="200" cy="200" r="110" class="lx-map__ring" />
      <circle cx="200" cy="200" r="46" class="lx-map__city" />
      <text x="200" y="12" class="lx-map__km">{H.area.km[L]}</text>
      {H.area.places.map(([x, y, n, big]) => (
        <g class={big ? 'lx-map__pt is-big' : 'lx-map__pt'}><circle cx={x} cy={y} r={big ? 4.5 : 2.6} /><text x={x + (big ? 9 : 6)} y={y + 4}>{n[L]}</text></g>
      ))}
    </svg>
  </div>
</section>

<!-- 11. ОТЗЫВЫ (честно) -->
<section class="lx-reviews">
  <div class="container">
    <p class="lx-reviews__t">{H.reviews[L]}</p>
  </div>
</section>

<!-- 12. ВОПРОСЫ -->
<section class="lx-sec lx-faq">
  <div class="container lx-faq__grid">
    <h2 class="lx-h2">{H.faqH2[L]}</h2>
    <Faq items={faqFor(locale)} reveal={false} />
  </div>
</section>

<!-- 13. ФИНАЛ -->
<section class="lx-sec lx-cta dark grain">
  <figure class="lx-cta__film" data-tape>
    <div class="tape__media lx-vid" data-video="1">
      <video muted loop playsinline preload="none" poster="/img/site/van-side.webp" width="1280" height="720" aria-label={H.vanAlt[L]}>
        <source data-src="/video/van.mp4" type="video/mp4" />
      </video>
      <span class="lx-ai">{ai}</span>
    </div>
  </figure>
  <div class="container">
    <h2 class="lx-mega">{H.endTitle[L]}</h2>
    <div class="lx-cta__row">
      <p class="lx-lead">{H.finalLead[L]}</p>
      <div class="lx-cta__btns">
        <a href={quote} class="btn btn--primary">{ui.cta.quote[L]}</a>
        <a href={`https://wa.me/${brand.contact.whatsapp}`} class="lux-link" target="_blank" rel="noopener">{ui.cta.writeWhatsapp[L]}</a>
      </div>
    </div>
  </div>
</section>

<!-- окно «Смотреть ролик» (видео грузится только по нажатию) -->
<dialog class="lx-modal" data-film-modal aria-label={H.modalAria[L]}>
  <button type="button" class="lx-modal__x" data-film-close aria-label={ui.cta.close[L]}>×</button>
  <video data-src="/video/film-1280.mp4" controls playsinline preload="none" poster="/scenes/film/poster-d.webp" width="1280" height="720"></video>
</dialog>

<style>
  /* ---------- общий ритм ---------- */
  .lx-sec { padding-block: clamp(96px, 13vw, 210px); }
  .lx-h2 { font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 200; letter-spacing: -0.045em; line-height: .98; max-width: 13ch; }
  .lx-xl { font-family: var(--font-display); font-size: var(--fs-xl); font-weight: 200; letter-spacing: -0.045em; line-height: .98; }
  .lx-mega { font-family: var(--font-display); font-size: var(--fs-mega); font-weight: 200; letter-spacing: -0.05em; line-height: .92; max-width: 11ch; }
  .lx-lead { font-size: clamp(1.05rem, 1rem + .3vw, 1.25rem); line-height: 1.6; color: var(--muted); max-width: 44ch; }
  .lx-head { display: grid; gap: 28px; margin-bottom: clamp(48px, 7vw, 104px); }
  @media (min-width: 960px) { .lx-head { grid-template-columns: 7fr 5fr; align-items: end; } }
  .lx-note { font-size: .875rem; color: var(--muted); }
  .lx-steps__note { margin-top: 32px; }

  /* ---------- первый экран: фильм ---------- */
  .lx-film { position: relative; background: var(--graphite); color: #fff; }
  .lx-film__stage { position: relative; height: 100svh; min-height: 580px; overflow: hidden; isolation: isolate; }
  .lx-film__poster, .lx-film__poster img, .lx-film__canvas, .lx-film__video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .lx-film__canvas { opacity: 0; transition: opacity .5s var(--ease-lux); }
  .lx-film:global(.is-live) .lx-film__canvas { opacity: 1; }
  .lx-film__video { display: none; opacity: 0; transition: opacity .8s var(--ease-lux); }
  .lx-film__shade { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(180deg, rgba(16,22,29,.62) 0%, rgba(16,22,29,0) 20%, rgba(16,22,29,0) 46%, rgba(16,22,29,.82) 100%),
                linear-gradient(90deg, rgba(16,22,29,.5) 0%, rgba(16,22,29,0) 58%); }

  .lx-film__intro { position: absolute; left: 0; right: 0; bottom: clamp(88px, 13vh, 150px); z-index: 2; display: grid; justify-items: start; }
  .lx-film__kicker { color: rgba(255,255,255,.72); font-size: 1rem; margin-bottom: clamp(16px, 2.4vw, 28px); }
  .lx-film__title { font-family: var(--font-display); font-size: clamp(2.2rem, max(min(11vw, 3rem), .9rem + 6.1vw), 8.2rem); font-weight: 200; letter-spacing: -0.055em; line-height: .9; color: #fff; }
  html.js .lx-film__title { visibility: hidden; }
  .lx-film__line { display: block; width: min(420px, 60%); height: 2px; margin: clamp(24px, 3vw, 40px) 0 clamp(20px, 2.6vw, 32px); background: var(--tape); transform-origin: 0 50%; }
  html.js .lx-film__line { transform: scaleX(0); }
  .lx-film__lead { font-size: clamp(1.05rem, 1rem + .35vw, 1.3rem); line-height: 1.6; color: rgba(255,255,255,.84); max-width: 38ch; }
  .lx-film__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: clamp(24px, 3vw, 40px); }
  .lx-film__cta .lux-link { color: #fff; }
  html.js [data-intro-fade] { opacity: 0; }
  .lx-film__hint { display: none; }

  /* подписи по ходу фильма */
  .lx-film__caps { position: absolute; left: 0; right: 0; bottom: clamp(88px, 13vh, 150px); z-index: 2; display: grid; pointer-events: none; }
  .lx-film__cap { grid-area: 1 / 1; display: grid; gap: 14px; justify-items: start; opacity: 0; transform: translateY(22px); transition: opacity .55s var(--ease-lux), transform .8s var(--ease-lux); }
  .lx-film__cap::before { content: ""; width: 64px; height: 2px; background: var(--tape); transform: scaleX(0); transform-origin: 0 50%; transition: transform .8s var(--ease-lux) .05s; }
  .lx-film__cap.is-on { opacity: 1; transform: none; }
  .lx-film__cap.is-on::before { transform: scaleX(1); }
  .lx-film__cap strong { font-family: var(--font-display); font-weight: 200; font-size: clamp(2rem, 1rem + 3.2vw, 4.6rem); letter-spacing: -0.05em; line-height: .95; max-width: 14ch; }
  .lx-film__cap span { font-size: clamp(1rem, .95rem + .3vw, 1.2rem); line-height: 1.55; color: rgba(255,255,255,.84); max-width: 34ch; }

  /* финал фильма: призыв */
  .lx-film__end { position: absolute; left: 0; right: 0; bottom: clamp(88px, 13vh, 150px); z-index: 2; display: grid; justify-items: start; opacity: 0; visibility: hidden; transform: translateY(22px); transition: opacity .6s var(--ease-lux), transform .8s var(--ease-lux), visibility 0s .6s; }
  .lx-film__end:global(.is-on) { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .lx-film__endt { font-family: var(--font-display); font-weight: 200; font-size: clamp(2.6rem, 1rem + 5vw, 6.4rem); letter-spacing: -0.055em; line-height: .92; max-width: 11ch; }

  .lx-film__foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 var(--gutter) calc(14px + var(--bar-h, 0px)); }
  .lx-film__watch { display: inline-flex; align-items: center; gap: 12px; min-height: 48px; padding: 0; border: 0; background: none; color: #fff; font: inherit; font-weight: 500; cursor: pointer; }
  .lx-film__watch i { position: relative; width: 36px; height: 36px; border: 1px solid rgba(255,255,255,.5); border-radius: 50%; transition: border-color .3s, background .3s; }
  .lx-film__watch i::after { content: ""; position: absolute; left: 14px; top: 11px; border-left: 10px solid #fff; border-top: 7px solid transparent; border-bottom: 7px solid transparent; }
