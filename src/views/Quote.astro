---
/**
 * Заявка: 6 шагов, по одному вопросу на экран. Сейчас это макет:
 * отправка в CRM, загрузка видео и календарь свободных дат подключаются на этапе «Заявка и CRM».
 * Тексты — src/content/quote.ts (сразу на 4 языках).
 */
import { brand } from '../config/brand';
import { href, type Locale } from '../i18n/routes';
import { quoteText as Q } from '../content/quote';
const { locale: L } = Astro.props as { locale: Locale };
---

<section class="q">
  <div class="container q__in">
    <div class="q__head">
      <span class="t-eyebrow">{Q.eyebrow[L]}</span>
      <h1 class="t-h2">{Q.h1[L]}</h1>
      <ol class="q__steps" aria-label={Q.stepsAria[L]}>{Q.steps.map((s, i) => <li data-step-dot={i}><span>{i + 1}</span>{s[L]}</li>)}</ol>
      <div class="q__bar" aria-hidden="true"><i data-q-bar></i></div>
    </div>

    <form class="q__form" data-quote novalidate data-lang={L} data-wa={brand.contact.whatsapp}>
      <fieldset data-q-step="0">
        <legend class="t-h3">{Q.q0[L]}</legend>
        <div class="opts">{Q.sizes.map((s, i) => <label class="opt"><input type="radio" name="size" value={i} id={`size-${i}`} checked={i === 1} /><span>{s[L]}</span></label>)}</div>
      </fieldset>

      <fieldset data-q-step="1" hidden>
        <legend class="t-h3">{Q.q1[L]}</legend>
        {['from', 'to'].map((k) => (
          <div class="addr">
            <label class="fld"><span>{k === 'from' ? Q.from[L] : Q.to[L]}</span><input id={`addr-${k}`} name={`addr_${k}`} autocomplete="street-address" placeholder={Q.addrPh[L]} /></label>
            <div class="row3">
              <label class="fld"><span>{Q.floor[L]}</span><input id={`floor-${k}`} name={`floor_${k}`} inputmode="numeric" placeholder="3" /></label>
              <label class="fld"><span>{Q.lift[L]}</span><select id={`lift-${k}`} name={`lift_${k}`}>{Q.liftOpts.map((o, i) => <option value={i}>{o[L]}</option>)}</select></label>
              <label class="fld"><span>{Q.dist[L]}</span><input id={`dist-${k}`} name={`dist_${k}`} inputmode="numeric" placeholder="20" /></label>
            </div>
          </div>
        ))}
      </fieldset>

      <fieldset data-q-step="2" hidden>
        <legend class="t-h3">{Q.q2[L]}</legend>
        <div class="row2">
          <label class="fld"><span>{Q.date[L]}</span><input type="date" id="date" name="date" data-min-today /></label>
          <label class="fld"><span>{Q.start[L]}</span><select id="time" name="time"><option>08:00</option><option>09:00</option><option>12:00</option><option>15:00</option><option value="evening">{Q.evening[L]}</option></select></label>
        </div>
        <label class="check"><input type="checkbox" id="flex" name="flex" /> {Q.flex[L]}</label>
      </fieldset>

      <fieldset data-q-step="3" hidden>
        <legend class="t-h3">{Q.q3[L]}</legend>
        <div class="cnt">{Q.items.map((x, i) => { const it = x[L]; return (
          <div class="cnt__row"><span>{it}</span><div class="cnt__ctl"><button type="button" data-dec aria-label={`${Q.less[L]}: ${it}`}>−</button><input id={`item-${i}`} name={`item_${i}`} value="0" inputmode="numeric" aria-label={it} /><button type="button" data-inc aria-label={`${Q.more[L]}: ${it}`}>+</button></div></div>
        ); })}</div>
        <label class="check"><input type="checkbox" id="skip-items" name="skip_items" /> {Q.skipItems[L]}</label>
      </fieldset>

      <fieldset data-q-step="4" hidden>
        <legend class="t-h3">{Q.q4[L]}</legend>
        <div class="opts">{Q.extras.map((e, i) => <label class="opt"><input type="checkbox" name="extras" value={i} id={`ex-${i}`} /><span>{e[L]}</span></label>)}</div>
      </fieldset>

      <fieldset data-q-step="5" hidden>
        <legend class="t-h3">{Q.q5[L]}</legend>
        <div class="row2">
          <label class="fld"><span>{Q.name[L]}</span><input id="name" name="name" autocomplete="name" /></label>
          <label class="fld"><span>{Q.phone[L]}</span><input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="+48" required aria-describedby="q-err" /></label>
        </div>
        <div class="opts opts--sm">{Q.channels.map((c, i) => <label class="opt"><input type="radio" name="channel" value={i} id={`ch-${i}`} checked={i === 0} /><span>{c[L]}</span></label>)}</div>
        <div id="video" class="video">
          <strong>{Q.videoT[L]}</strong>
          <p class="t-muted">{Q.videoD[L]}</p>
          <div class="video__opts">
            <label class="btn btn--ghost btn--sm">{Q.upload[L]}<input type="file" accept="video/*" multiple hidden id="video-file" data-q-files /></label>
            <a class="btn btn--ghost btn--sm" href={`https://wa.me/${brand.contact.whatsapp}`} target="_blank" rel="noopener">{Q.sendWa[L]}</a>
          </div>
          <ul class="video__list" data-q-list hidden aria-label={Q.chosen[L]}></ul>
        </div>
        <label class="check"><input type="checkbox" id="nip" name="nip" /> {Q.nip[L]}</label>
        <label class="fld"><span>{Q.comment[L]}</span><textarea id="comment" name="comment" rows="3" maxlength="1500" placeholder={Q.commentPh[L]}></textarea></label>
        <p class="q__consent">{Q.consent[L]} <a href={href(L, 'privacy')}>{Q.privacy[L]}</a></p>
        <div class="q__hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      </fieldset>

      <div class="q__done" data-q-done hidden>
        <span class="t-eyebrow">{Q.doneEyebrow[L]} <b data-q-id></b></span>
        <h2 class="t-h2">{Q.doneH[L]}</h2>
        <p class="t-lead">{Q.doneLead[L]}</p>
        <p class="q__warn" data-q-vwarn hidden>{Q.errVideo[L]} <a href={`https://wa.me/${brand.contact.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a></p>
      </div>

      <div class="q__status" data-q-status hidden><span data-q-status-t></span><i><b data-q-prog></b></i></div>
      <p class="q__err" id="q-err" role="alert" data-q-err hidden data-phone={Q.errPhone[L]} data-send={Q.errSend[L]}></p>

      <div class="q__nav">
        <button type="button" class="btn btn--ghost" data-q-prev hidden>{Q.prev[L]}</button>
        <button type="button" class="btn btn--primary" data-q-next data-l-next={Q.next[L]} data-l-send={Q.send[L]} data-l-sending={Q.sending[L]} data-l-uploading={Q.uploading[L]}>{Q.next[L]} <span class="arrow">→</span></button>
      </div>
    </form>

    <aside class="q__sum" aria-label={Q.sum[L]}>
      <span class="t-eyebrow">{Q.sum[L]}</span>
      <dl>
        <dt>{Q.vol[L]}</dt><dd data-sum="size">{Q.sizes[1][L]}</dd>
        <dt>{Q.est[L]}</dt><dd data-sum="est" data-from={Q.estFrom[L]}>{Q.estVal[L]}</dd>
      </dl>
      <p class="t-muted">{Q.sumNote[L]}</p>
    </aside>
  </div>
</section>

<script>
  type Up = { key: string; name: string; size: number };
  const T0 = Date.now();

  /** загрузка одного видео в хранилище кусками по 10 МБ; onProgress — доля 0…1 */
  async function uploadVideo(file: File, onProgress: (x: number) => void): Promise<Up | null> {
    const start = await fetch('/api/upload/start', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ name: file.name, type: file.type, size: file.size }) });
    if (!start.ok) return null;
    const { key, uploadId, part } = await start.json();
    const parts: { partNumber: number; etag: string }[] = [];
    const total = Math.ceil(file.size / part);
    for (let n = 1; n <= total; n++) {
      const chunk = file.slice((n - 1) * part, Math.min(file.size, n * part));
      let r: Response | null = null;
      for (let tries = 0; tries < 3 && !r?.ok; tries++) {
        r = await fetch(`/api/upload/part?key=${encodeURIComponent(key)}&uploadId=${encodeURIComponent(uploadId)}&n=${n}`, { method: 'PUT', body: chunk }).catch(() => null);
      }
      if (!r?.ok) return null;
      parts.push(await r.json());
      onProgress(n / total);
    }
    const done = await fetch('/api/upload/complete', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ key, uploadId, parts }) });
    return done.ok ? { key, name: file.name, size: file.size } : null;
  }

  function initQuote() {
    const form = document.querySelector<HTMLFormElement>('[data-quote]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const steps = [...form.querySelectorAll<HTMLElement>('[data-q-step]')];
    const dots = [...document.querySelectorAll<HTMLElement>('[data-step-dot]')];
    const bar = document.querySelector<HTMLElement>('[data-q-bar]')!;
    const prev = form.querySelector<HTMLButtonElement>('[data-q-prev]')!;
    const next = form.querySelector<HTMLButtonElement>('[data-q-next]')!;
    const done = form.querySelector<HTMLElement>('[data-q-done]')!;
    const err = form.querySelector<HTMLElement>('[data-q-err]')!;
    const status = form.querySelector<HTMLElement>('[data-q-status]')!;
    const statusT = form.querySelector<HTMLElement>('[data-q-status-t]')!;
    const prog = form.querySelector<HTMLElement>('[data-q-prog]')!;
    const filesInp = form.querySelector<HTMLInputElement>('[data-q-files]')!;
    const list = form.querySelector<HTMLElement>('[data-q-list]')!;
    const fmt = new Intl.NumberFormat(document.documentElement.lang || 'pl');
    const mb = (n: number) => (n >= 1024 ** 3 ? `${(n / 1024 ** 3).toFixed(1)} GB` : `${Math.max(1, Math.round(n / 1024 ** 2))} MB`);
    let i = 0, busy = false;

    const showErr = (msg: string) => { err.textContent = msg; err.hidden = !msg; };
    const show = (n: number) => {
      i = n;
      steps.forEach((s, k) => (s.hidden = k !== n));
      dots.forEach((d, k) => { d.classList.toggle('is-done', k < n); d.classList.toggle('is-on', k === n); });
      bar.style.transform = `scaleX(${(n + 1) / steps.length})`;
      prev.hidden = n === 0;
      next.innerHTML = n === steps.length - 1 ? (next.dataset.lSend ?? '') : `${next.dataset.lNext ?? ''} <span class="arrow">→</span>`;
      showErr('');
      steps[n].querySelector<HTMLElement>('input,select,button')?.focus({ preventScroll: true });
    };

    form.querySelector('#phone')?.addEventListener('input', () => showErr(''));
    // выбранные видео — список с размерами
    filesInp.addEventListener('change', () => {
      const fs = [...(filesInp.files || [])];
      list.innerHTML = '';
      fs.forEach((f) => { const li = document.createElement('li'); li.textContent = `${f.name} · ${mb(f.size)}`; list.append(li); });
      list.hidden = !fs.length;
    });

    const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '';
    const num = (n: string) => { const v = form.querySelector<HTMLInputElement>(`input[name="${n}"]:checked`)?.value; return v == null ? -1 : Number(v); };
    const chk = (n: string) => !!(form.elements.namedItem(n) as HTMLInputElement | null)?.checked;

    async function send() {
      const phone = val('phone').trim();
      if ((phone.match(/\d/g) || []).length < 7) {
        showErr(err.dataset.phone || '');
        form.querySelector<HTMLInputElement>('#phone')?.focus();
        return;
      }
      busy = true; next.disabled = prev.disabled = true; showErr('');
      status.hidden = false;
      // 1) видео
      const videos: Up[] = [], skipped: { name: string; size: number }[] = [];
      const fs = [...(filesInp.files || [])];
      const total = fs.reduce((a, f) => a + f.size, 0) || 1;
      let doneBytes = 0;
      for (const f of fs) {
        statusT.textContent = `${next.dataset.lUploading} · ${f.name}`;
        const up = await uploadVideo(f, (x) => { prog.style.width = `${Math.round(((doneBytes + x * f.size) / total) * 100)}%`; }).catch(() => null);
        if (up) videos.push(up); else skipped.push({ name: f.name, size: f.size });
        doneBytes += f.size;
      }
      // 2) заявка
      statusT.textContent = next.dataset.lSending || '';
      prog.style.width = '100%';
      const qs = new URLSearchParams(location.search);
      const body = {
        lang: form.dataset.lang, size: num('size'), est: Number(qs.get('est')) || undefined,
        from: { addr: val('addr_from'), floor: val('floor_from'), lift: Number(val('lift_from')), dist: val('dist_from') },
        to: { addr: val('addr_to'), floor: val('floor_to'), lift: Number(val('lift_to')), dist: val('dist_to') },
        date: val('date'), time: val('time'), flex: chk('flex'),
        items: [...form.querySelectorAll<HTMLInputElement>('.cnt__row input')].map((x) => Number(x.value) || 0), skipItems: chk('skip_items'),
        extras: [...form.querySelectorAll<HTMLInputElement>('input[name="extras"]:checked')].map((x) => Number(x.value)),
        name: val('name'), phone, channel: num('channel'), nip: chk('nip'), comment: val('comment'),
        videos, skipped, hp: val('website'), t: T0,
      };
      try {
        const r = await fetch('/api/quote', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.ok) throw new Error(d.error || String(r.status));
        steps.forEach((s) => (s.hidden = true)); prev.hidden = next.hidden = true; status.hidden = true;
        form.querySelector('[data-q-id]')!.textContent = d.id;
        form.querySelector<HTMLElement>('[data-q-vwarn]')!.hidden = !skipped.length;
        done.hidden = false; bar.style.transform = 'scaleX(1)';
        done.scrollIntoView({ block: 'center', behavior: 'smooth' });
      } catch {
        status.hidden = true;
        const wa = form.dataset.wa;
        err.innerHTML = '';
        err.append(err.dataset.send || '', ' ');
        const a = document.createElement('a'); a.href = `https://wa.me/${wa}`; a.target = '_blank'; a.rel = 'noopener'; a.textContent = 'WhatsApp'; err.append(a);
        err.hidden = false;
      } finally {
        busy = false; next.disabled = prev.disabled = false;
      }
    }

    next.addEventListener('click', () => {
      if (busy) return;
      if (i < steps.length - 1) return show(i + 1);
      send();
    });
    prev.addEventListener('click', () => !busy && show(Math.max(0, i - 1)));
    form.addEventListener('submit', (e) => { e.preventDefault(); if (i === steps.length - 1 && !busy) send(); });
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'size') document.querySelector('[data-sum="size"]')!.textContent = t.nextElementSibling?.textContent || '';
    });
    form.querySelectorAll('.cnt__row').forEach((row) => {
      const inp = row.querySelector('input')!;
      row.querySelector('[data-inc]')!.addEventListener('click', () => (inp.value = String(+inp.value + 1)));
      row.querySelector('[data-dec]')!.addEventListener('click', () => (inp.value = String(Math.max(0, +inp.value - 1))));
    });
    const date = form.querySelector<HTMLInputElement>('[data-min-today]');
    if (date) date.min = new Date().toISOString().slice(0, 10);
    // выбор из калькулятора: ?size=1&ex=0,3&est=2340
    const qs = new URLSearchParams(location.search);
    const size = form.querySelector<HTMLInputElement>(`#size-${qs.get('size')}`);
    if (size) { size.checked = true; document.querySelector('[data-sum="size"]')!.textContent = size.nextElementSibling?.textContent || ''; }
    (qs.get('ex') || '').split(',').forEach((n) => { const c = form.querySelector<HTMLInputElement>(`#ex-${n}`); if (c) c.checked = true; });
    const est = Number(qs.get('est'));
    const estEl = document.querySelector<HTMLElement>('[data-sum="est"]');
    if (est > 0 && estEl) estEl.textContent = `${estEl.dataset.from} ${fmt.format(est)} zł`;
    if (location.hash === '#video') show(steps.length - 1); else show(0);
  }
  document.addEventListener('astro:page-load', initQuote);
</script>

<style>
  .q { padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + 32px); padding-bottom: 96px; }
  .q__in { display: grid; gap: 32px; }
  @media (min-width: 1024px) { .q__in { grid-template-columns: 1fr 340px; column-gap: 64px; } .q__head { grid-column: 1 / -1; } }
  .q__head { display: grid; gap: 18px; }
  .q__steps { display: flex; gap: 8px; list-style: none; padding: 0; margin: 0; overflow-x: auto; scrollbar-width: none; }
  .q__steps li { display: flex; align-items: center; gap: 8px; font-size: .85rem; color: var(--muted); white-space: nowrap; padding: 6px 12px 6px 6px; border-radius: 999px; border: 1px solid var(--line); }
  .q__steps li span { width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font-size: .75rem; background: var(--line); color: var(--ink); }
  .q__steps li.is-on { color: var(--ink); border-color: var(--ink); }
  .q__steps li.is-on span, .q__steps li.is-done span { background: var(--accent); color: var(--accent-ink); }
  .q__bar { height: 3px; background: var(--line); border-radius: 3px; overflow: hidden; }
  .q__bar i { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(.16); transition: transform .6s var(--ease); }
  .q__form { display: grid; gap: 28px; min-width: 0; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 18px; min-width: 0; }
  legend { margin-bottom: 18px; padding: 0; }
  .opts { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; }
  .opts--sm { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
  .opt { position: relative; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; }
  .opt span { display: flex; align-items: center; min-height: 64px; padding: 14px 16px; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); font-weight: 560; transition: border-color .2s, background .2s, color .2s; }
  .opt input:checked + span { border-color: var(--ink); background: var(--ink); color: var(--bg); }
  .opt input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
  .fld { display: grid; gap: 6px; font-size: .85rem; color: var(--muted); min-width: 0; }
  .fld input, .fld select { height: 54px; padding: 0 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-size: 1rem; width: 100%; min-width: 0; }
  .fld input:focus, .fld select:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .addr { display: grid; gap: 10px; padding-bottom: 14px; }
  .row2, .row3 { display: grid; gap: 10px; }
  @media (min-width: 560px) { .row2 { grid-template-columns: 1fr 1fr; } .row3 { grid-template-columns: repeat(3, 1fr); } }
  .check { display: flex; gap: 10px; align-items: center; font-weight: 500; }
  .check input { width: 20px; height: 20px; accent-color: var(--accent-text); }
  .cnt { display: grid; border-top: 1px solid var(--line); }
  .cnt__row { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-weight: 520; }
  .cnt__ctl { display: flex; align-items: center; gap: 4px; }
  .cnt__ctl button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); font-size: 1.2rem; cursor: pointer; }
  .cnt__ctl input { width: 44px; text-align: center; border: 0; background: transparent; font: inherit; font-weight: 600; }
  .video { display: grid; gap: 10px; padding: 20px; border-radius: var(--radius); border: 1px dashed var(--accent); background: color-mix(in oklab, var(--accent) 5%, var(--surface)); }
  .video__opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .video__opts label { cursor: pointer; }
  .video__list { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 4px; font-size: .9rem; color: var(--muted); word-break: break-all; }
  .video__list li::before { content: "▶ "; color: var(--accent-text); }
  .fld textarea { padding: 14px 16px; border-radius: 14px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: inherit; font-size: 1rem; width: 100%; resize: vertical; }
  .fld textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .q__consent { font-size: .82rem; color: var(--muted); }
  .q__consent a, .q__warn a, .q__err a { color: var(--accent-text); text-decoration: underline; text-underline-offset: 3px; }
  .q__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .q__status { display: grid; gap: 8px; font-size: .92rem; color: var(--muted); }
  .q__status i { display: block; height: 4px; border-radius: 4px; background: var(--line); overflow: hidden; }
  .q__status b { display: block; height: 100%; width: 0; background: var(--accent); transition: width .3s; }
  .q__err { padding: 12px 16px; border-radius: 12px; background: #FDECEC; color: #8A1C1C; font-weight: 500; }
  .q__warn { padding: 12px 16px; border-radius: 12px; background: #FFF6E0; color: #6B4A00; }
  .q__nav .btn:disabled { opacity: .55; cursor: progress; }
  .q__nav { display: flex; gap: 10px; justify-content: space-between; }
  .q__nav .btn--primary { margin-left: auto; }
  .q__done { display: grid; gap: 16px; }
  .q__sum { align-self: start; position: sticky; top: calc(var(--header-h) + 24px); display: grid; gap: 14px; padding: 24px; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line); }
  .q__sum dl { display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; margin: 0; }
  .q__sum dt { color: var(--muted); } .q__sum dd { margin: 0; font-weight: 600; text-align: right; }
  @media (max-width: 1023px) { .q__head { order: -2; } .q__sum { position: static; order: -1; } }
  /* страница начинается со светлого фона — шапке нужен тёмный фон, иначе белое «MEL» не видно */
  :global(html:has(.q) .hdr) { background: color-mix(in oklab, var(--dark) 92%, transparent); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); box-shadow: 0 1px 0 #26303B; }
</style>
